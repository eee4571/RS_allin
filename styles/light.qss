* {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
    color: #20242a;
}
QMainWindow, QWidget { background: #f5f6f8; }
QMenuBar { background: #ffffff; border-bottom: 1px solid #d9dee5; padding: 2px; }
QMenuBar::item:selected, QMenu::item:selected { background: #eaf2ff; color: #2563eb; }
QMenu { background: #ffffff; border: 1px solid #d9dee5; padding: 5px; }
QToolBar { background: #ffffff; border: 0; border-bottom: 1px solid #d9dee5; spacing: 6px; padding: 0; }
QToolBar#moduleToolbar { border-bottom: 1px solid #d9dee5; }
QToolBar QToolButton { padding: 5px 11px; border-radius: 4px; }
QToolBar QToolButton:hover { background: #eff6ff; }
#ribbon { background: #ffffff; min-height: 46px; max-height: 46px; }
#ribbonButton { border: 0; border-bottom: 3px solid transparent; border-radius: 0; padding: 4px 14px 2px 14px; min-height: 34px; color: #20242a; }
#ribbonButton:hover { background: #f3f7fd; color: #2563eb; }
#ribbonButton:checked { background: #ffffff; border-bottom: 3px solid #2563eb; color: #2563eb; font-weight: 600; }
#ribbonButton:checked:hover { background: #e3edff; }
#modulePlaceholder { color: #a1a8b0; font-size: 13px; }
#moduleTitle { font-size: 17px; font-weight: 700; color: #20242a; }
#moduleStatus { color: #667085; }
#moduleDescription { color: #667085; }
#moduleSeparator { color: #e3e7ed; }
#moduleStack, #moduleParameterScroll, #moduleParameterScroll > QWidget > QWidget { background: #ffffff; }
#workflowSteps { background: #ffffff; border: 1px solid #e0e4ea; border-radius: 4px; }
#workflowSteps::item { padding: 4px 6px; }
QDockWidget { color: #34404d; font-weight: 600; }
QDockWidget::title { background: #ffffff; border: 0; border-bottom: 1px solid #d9dee5; padding: 7px 9px; text-align: left; }
QDockWidget > QWidget { border: 1px solid #d9dee5; }
QTreeWidget, QPlainTextEdit, QTableWidget, QScrollArea { background: #ffffff; border: 0; }
QTreeWidget::item { padding: 5px; }
QTreeWidget::item:selected { background: #eaf2ff; color: #2563eb; }
#panelTitleSmall { font-size: 15px; font-weight: 700; padding: 4px; }
#sectionTitle { font-size: 14px; font-weight: 700; color: #34404d; padding-top: 3px; }
#panelToolButton, #mapToolButton { border: 1px solid transparent; color: #667085; padding: 4px 7px; }
#panelToolButton:hover, #mapToolButton:hover { background: #eff6ff; border-color: #c7d9ff; color: #2563eb; }
#mapContextBar { background: #ffffff; border-bottom: 1px solid #d9dee5; min-height: 38px; max-height: 44px; }
#mapContextValue { color: #20242a; font-weight: 600; }
#periodBadge { background: #f5f6f8; border: 1px solid #d9dee5; border-radius: 4px; padding: 4px 8px; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #d9dee5; border-radius: 5px; padding: 6px 8px; min-height: 20px; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border: 1px solid #2563eb; }
QCheckBox { padding: 5px 0; }
QPushButton { border: 1px solid #c7cdd6; border-radius: 5px; background: #ffffff; padding: 6px 12px; }
QPushButton:hover { background: #eff6ff; border-color: #9bbaff; }
#primaryButton { color: white; background: #2563eb; border: 1px solid #1d4ed8; font-weight: 700; }
#primaryButton:hover { background: #1d4ed8; }
#primaryButton:disabled { background: #aebbd3; border-color: #aebbd3; }
#secondaryButton { background: #f5f6f8; }
QProgressBar { background: #e5e7eb; border: 0; border-radius: 5px; text-align: center; min-height: 14px; }
QProgressBar::chunk { background: #2563eb; border-radius: 5px; }
QStatusBar { background: #ffffff; border-top: 1px solid #d9dee5; }
QTabWidget::pane { border: 0; }
QTabBar::tab { background: #eef0f3; padding: 7px 16px; margin-right: 2px; }
QTabBar::tab:selected { background: #ffffff; color: #2563eb; border-top: 2px solid #2563eb; }
QHeaderView::section { background: #f0f2f5; border: 0; border-right: 1px solid #d9dee5; padding: 5px; font-weight: 600; }
QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #c4cbd4; border-radius: 5px; min-height: 25px; }
QSplitter#rightSidebarSplitter::handle { background: #d9dee5; height: 5px; }
#roadPanel, #roadModeStack, #roadModeScroll, #roadModePage,
#roadModeScroll > QWidget > QWidget { background: #ffffff; }
#roadPanel QLabel, #roadPanel QCheckBox { background: transparent; }
#roadContextStatus { color: #667085; padding-bottom: 2px; }
#roadModeBar { background: #ffffff; border-bottom: 1px solid #d9dee5; }
#roadModeButton { border: 0; border-bottom: 2px solid transparent; border-radius: 0; padding: 6px 14px; color: #475467; }
#roadModeButton:hover { background: #f3f7fd; color: #2563eb; }
#roadModeButton:checked { color: #2563eb; border-bottom: 2px solid #2563eb; font-weight: 600; background: #ffffff; }
#roadSectionTitle { font-weight: 700; color: #34404d; padding-top: 2px; }
#roadFieldLabel { color: #475467; font-weight: 600; }
#roadDataReady, #roadDataSummaryReady { color: #198754; }
#roadDataPending { color: #7b8794; }
#roadDataSummaryPending { color: #9a6700; }
#roadStatus { background: #f5f7fa; color: #475467; border-left: 3px solid #2563eb; padding: 5px 7px; }
#roadSeparator { color: #e3e7ed; }
#roadAdvancedToggle { border: 0; color: #475467; padding: 4px 0; }
#roadAdvancedToggle:hover { color: #2563eb; }
#roadWorkflowSteps { background: #ffffff; border: 1px solid #e0e4ea; border-radius: 3px; }
#roadWorkflowSteps::item { padding: 3px 6px; }
#roadLocalTabs::pane { border: 1px solid #e0e4ea; }
#roadLocalTabs QTabBar::tab { padding: 5px 12px; }
